# Zendesk Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-zendesk --about` for the
# authoritative list.

# Required: OAuth client ID for the Zendesk OAuth app
TAP_ZENDESK_CLIENT_ID=your_client_id_here

# Required: OAuth client secret for the Zendesk OAuth app
TAP_ZENDESK_CLIENT_SECRET=your_client_secret_here

# Required: OAuth refresh token
TAP_ZENDESK_REFRESH_TOKEN=your_refresh_token_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_ZENDESK_START_DATE=2023-01-01T00:00:00Z

# Required: Zendesk subdomain, i.e. the `acme` in `acme.zendesk.com`
TAP_ZENDESK_SUBDOMAIN=your_subdomain_here
